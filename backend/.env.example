# ==============================================================
# LocalSM AI Exam Portal — Environment Variable Template
#
# SECURITY NOTICE:
#   - Copy this file to .env and fill in real values.
#   - NEVER commit .env to version control.
#   - NEVER put real secrets in this file.
#   - All secrets should be managed via a secrets manager in
#     production (e.g. AWS Secrets Manager, HashiCorp Vault,
#     GCP Secret Manager, Azure Key Vault).
#   - Generate secrets using the commands shown in comments.
# ==============================================================

# ──────────────────────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
# Set to false in production
DEBUG=false

# ──────────────────────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────────────────────
# Format: postgresql+asyncpg://user:password@host:port/dbname
# Use a least-privilege PostgreSQL role for the application.
# Required permissions: SELECT, INSERT, UPDATE, DELETE on app tables.
# DO NOT use the postgres superuser.
DATABASE_URL=

# URL for the test database (used by pytest --integration tests only)
TEST_DATABASE_URL=

# ──────────────────────────────────────────────────────────────
# Database Connection Pool
# ──────────────────────────────────────────────────────────────
# pool_size: number of connections kept open in the pool.
# max_overflow: extra connections allowed when pool is full.
# pool_timeout: seconds to wait for a connection before error.
# pool_recycle: seconds before a connection is recycled (prevents
#               stale connections after network interruptions).
# Tune based on your PostgreSQL max_connections setting.
# Rule of thumb: pool_size + max_overflow <= max_connections / app_instances
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800

# ──────────────────────────────────────────────────────────────
# JWT
# ──────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# Minimum 256-bit (64 hex chars). Never hard-code. Never commit.
JWT_SECRET_KEY=

# Allowed values: HS256, HS384, HS512, RS256, RS384, RS512, ES256
# For asymmetric algorithms, set JWT_PRIVATE_KEY and JWT_PUBLIC_KEY instead.
JWT_ALGORITHM=HS256

# Required only for RS256/RS384/RS512/ES256 (asymmetric):
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Optional: set to validate the "iss" (issuer) claim in JWTs
JWT_ISSUER=

# Optional: set to validate the "aud" (audience) claim in JWTs
JWT_AUDIENCE=

# ──────────────────────────────────────────────────────────────
# Token Expiry
# ──────────────────────────────────────────────────────────────
# Short-lived access tokens reduce exposure window if leaked.
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Refresh tokens are rotated on every use — 7 days is standard.
REFRESH_TOKEN_EXPIRE_DAYS=7

# ──────────────────────────────────────────────────────────────
# Password Hashing
# ──────────────────────────────────────────────────────────────
# bcrypt cost factor. Higher = slower and more brute-force resistant.
# Minimum: 12. Tune so hashing takes ~250ms on your production hardware.
# Formula: time ≈ 2^rounds / hardware_speed
BCRYPT_ROUNDS=12

# ──────────────────────────────────────────────────────────────
# OTP (One-Time Password)
# ──────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Server-side secret for OTP HMAC-SHA256 hashing.
# Generate independently from JWT_SECRET_KEY. Never commit.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
OTP_HASH_SECRET=

# ──────────────────────────────────────────────────────────────
# CORS / Frontend
# ──────────────────────────────────────────────────────────────
# Exact origin of the frontend application. No trailing slash. No wildcard.
# Example: https://exam.localsm.example.com
# Never use "*" — it would disable CSRF protection via credentials.
FRONTEND_URL=

# ──────────────────────────────────────────────────────────────
# Cookie Settings
# ──────────────────────────────────────────────────────────────
# Set COOKIE_SECURE=true in production (requires HTTPS).
# COOKIE_SECURE=false is only acceptable in local development.
COOKIE_SECURE=true

# Options: strict | lax | none
# "strict" is the most secure but may break OAuth redirects.
# "lax" is the standard choice for most SPAs (allows top-level navigation).
# "none" requires COOKIE_SECURE=true and is only for cross-site scenarios.
COOKIE_SAMESITE=lax

# Leave empty to use the request domain (browser default).
# Set to ".example.com" to share cookies across subdomains.
COOKIE_DOMAIN=

# ──────────────────────────────────────────────────────────────
# Rate Limiting
# ──────────────────────────────────────────────────────────────
# Format understood by the `limits` library: "N/unit"
# Examples: "5/minute", "100/hour", "1000/day"
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_SIGNUP=5/minute
RATE_LIMIT_FORGOT_PASSWORD=3/minute
RATE_LIMIT_VERIFY_OTP=5/minute
RATE_LIMIT_RESET_PASSWORD=5/minute
RATE_LIMIT_REFRESH=10/minute

# ──────────────────────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────────────────────
# Loguru log level: TRACE | DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# "json" for production (structured, machine-parseable)
# "text" for development (human-readable, coloured)
LOG_FORMAT=json

# Path to a rotating log file (optional).
# Leave empty to write to stdout only.
# Example: logs/app.log
LOG_FILE_PATH=
