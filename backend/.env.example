# ==============================================================
# LocalSM AI Exam Portal — Environment Variable Template
#
# SECURITY NOTICE:
#   - Copy this file to .env and fill in real values.
#   - NEVER commit .env to version control.
#   - NEVER put real secrets in this file.
#   - All secrets should be managed by a secrets manager in
#     production (e.g. AWS Secrets Manager, Vault, GCP Secret).
# ==============================================================

# --- Application ---
ENVIRONMENT=development
DEBUG=false

# --- Database ---
# Format: postgresql+asyncpg://user:password@host:port/dbname
# Use a least-privilege PostgreSQL role for the application.
# The role needs: SELECT, INSERT, UPDATE, DELETE on app tables.
# Do NOT use the postgres superuser.
DATABASE_URL=
TEST_DATABASE_URL=

# --- JWT ---
# Generate with: python -c "import secrets; print(secrets.token_hex(64))"
# Minimum 256-bit (64 hex chars). Never hard-code. Never commit.
JWT_SECRET_KEY=

# Allowed values: HS256, HS384, HS512
# For RS256 (asymmetric), set JWT_PRIVATE_KEY and JWT_PUBLIC_KEY instead.
JWT_ALGORITHM=HS256

# Optional: set to validate the "iss" claim in JWTs
JWT_ISSUER=

# Optional: set to validate the "aud" claim in JWTs
JWT_AUDIENCE=

# --- Token Expiry ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Password Hashing ---
# bcrypt cost factor. Higher = slower but more resistant to brute force.
# Minimum recommended: 12. Tune so hash takes ~250ms on your hardware.
# Formula: time ≈ 2^rounds / (hardware_speed)
BCRYPT_ROUNDS=12

# --- OTP ---
OTP_EXPIRE_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Generate independently from JWT_SECRET_KEY. Never commit the real value.
OTP_HASH_SECRET=

# --- CORS / Frontend ---
# Exact origin of the frontend. No trailing slash. No wildcard.
# Example: https://exam.localsm.example.com
FRONTEND_URL=

# --- Cookie Settings ---
# Set COOKIE_SECURE=true in production (requires HTTPS).
COOKIE_SECURE=true
# Options: strict | lax | none
# Use "none" only if frontend is on a different domain AND you use SameSite=None; Secure
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# --- Rate Limiting ---
# Format understood by the `limits` library, e.g.: "5/minute", "10/minute"
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_SIGNUP=5/minute
RATE_LIMIT_FORGOT_PASSWORD=3/minute
RATE_LIMIT_VERIFY_OTP=5/minute
RATE_LIMIT_RESET_PASSWORD=5/minute
RATE_LIMIT_REFRESH=10/minute

# --- Logging ---
# Loguru log level: TRACE | DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# "json" for production (structured), "text" for development
LOG_FORMAT=json
# Directory for log files (optional; omit to log to stdout only)
LOG_FILE_PATH=logs/app.log
